// Worker code is TypeScript and the runtime here is plain Node, so `npm test`
// compiles the modules under test to .test-build/ and runs node:test over the
// output. Only what the tests import gets compiled — no bundler, and no
// workerd.
//
// The Workers types sit BESIDE the Node ones (rather than instead of, as in
// tsconfig.json) since `tests/notion-write.test.ts`: a mocked-fetch test over a
// real integration reaches `Env`, and `Env` names the Durable Object and KV
// binding types. `skipLibCheck` keeps the two global sets from arguing. The
// boundary that still holds is the RUNTIME one — a test here runs on Node, so a
// module that needs workerd belongs in tests/workerd/ (see the exclude below).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "@cloudflare/workers-types"],
    "noEmit": false,
    "outDir": ".test-build"
  },
  // tests/workerd/ is the ONE suite that needs Cloudflare's runtime: vitest
  // compiles it itself (vitest.workerd.config.mts, `npm run test:workerd`), and
  // it reaches the Durable Object adapter, which names Workers types this
  // compile does not have. Compiling it here would drag `DurableObjectNamespace`
  // and `cloudflare:test` into the Node build and fail — the same
  // Workers-global-free boundary the module's own files keep.
  "exclude": ["tests/workerd/**"],
  "include": ["tests/**/*.ts", "src/integrations/notion.ts", "src/agent/draft-judge-rubric.ts", "src/tools/slack-search-filter.ts", "src/agent/revision-guard.ts", "src/tools/slack-search-response.ts", "src/slack/footer-kind.ts", "src/slack/stream-recipient.ts", "src/slack/transcript-window.ts", "src/slack/shortcut-specs.ts", "src/slack/effort.ts", "src/agent/tiers.ts", "src/agent/routing.ts", "src/agent/gemini-tiers.ts", "src/slack/failure-message.ts", "src/slack/antecedent.ts", "src/agent/scope-keywords.ts", "src/agent/context-state.ts", "src/integrations/blueprint-link.ts", "src/integrations/blueprint-index.ts", "src/integrations/blueprint-include.ts", "src/integrations/candidate-rpc.ts", "src/vertex/embed-model.ts", "src/integrations/index-model.ts", "src/slack/gate-reactions.ts", "src/agent/confidence.ts", "src/slack/mrkdwn.ts", "src/integrations/notion-blocks.ts", "src/integrations/email-render.ts", "src/slack/split.ts", "src/slack/answer-posts.ts", "src/slack/render.ts", "src/tools/share-out-render.ts", "src/agent/pending-notice.ts", "src/agent/absence.ts", "src/integrations/repo-read-guard.ts", "src/integrations/figma-reading.ts", "src/integrations/blueprint-schema.ts", "src/tools/read-reference.ts", "src/generated/references.ts", "src/tools/blueprint-inventory-notes.ts", "src/integrations/blueprint-scope.ts", "src/tools/blueprint-touchpoint-notes.ts", "src/integrations/blueprint-subject.ts", "src/agent/tool-transcript.ts", "src/agent/placeholder.ts", "src/thread-state/index.ts", "src/agent/types.ts", "src/version.ts", "src/agent/model-provider.ts", "src/agent/loop-policy.ts", "src/agent/loop.ts", "src/agent/providers/fake.ts", "src/agent/providers/claude.ts", "src/turn/index.ts", "src/eval/turn-case.ts", "src/gate/index.ts", "src/slack/working-signal.ts", "src/slack/session-stop.ts", "src/agent/tool-table.ts", "src/tools/slack-react.ts", "src/agent/tool-bodies.ts", "src/oauth/slack.ts", "src/diagnostics/routes.ts", "src/diagnostics/auth.ts", "src/diagnostics/router.ts", "src/tools/blueprint-search.ts"]
}
