      ],
      "why": "the 08 / 12 / 16 state steps are gone; use the named hovered, pressed and selected tokens",
      "rule": "state-step",
      "caseSensitive": true,
      "pattern": "--[a-z0-9-]*-state-(?:08|12|16)(?![0-9])"
    },
