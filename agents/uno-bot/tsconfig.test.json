// Worker code is TypeScript and the runtime here is plain Node, so `npm test`
// compiles the pure modules under test to .test-build/ and runs node:test over
// the output. Only what the tests import gets compiled — no Workers types, no
// fetch, no bundler.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": false,
    "outDir": ".test-build"
  },
  "include": ["tests/**/*.ts", "src/agent/draft-judge-rubric.ts", "src/tools/slack-search-filter.ts", "src/agent/revision-guard.ts", "src/tools/slack-search-response.ts", "src/slack/footer-kind.ts", "src/slack/transcript-window.ts", "src/slack/shortcut-specs.ts", "src/slack/effort.ts", "src/agent/tiers.ts", "src/slack/failure-message.ts", "src/slack/antecedent.ts", "src/agent/scope-keywords.ts", "src/agent/context-state.ts", "src/integrations/blueprint-link.ts", "src/integrations/blueprint-index.ts", "src/integrations/blueprint-include.ts", "src/integrations/candidate-rpc.ts", "src/slack/gate-reactions.ts", "src/agent/confidence.ts", "src/slack/mrkdwn.ts", "src/integrations/notion-blocks.ts", "src/integrations/email-render.ts", "src/slack/split.ts", "src/tools/share-out-render.ts", "src/agent/pending-notice.ts", "src/agent/absence.ts", "src/integrations/repo-read-guard.ts"]
}
