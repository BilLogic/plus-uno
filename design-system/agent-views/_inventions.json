    {
      "not": "tier it",
      "use": [
        "classify its severity"
      ],
      "why": "\"classify its severity\"",
      "caseSensitive": true,
      "pattern": "\\btier it\\b"
    },
    {
      "not": "uno-tier1-digest",
      "use": [
        "a direct fix leaves its commit"
      ],
      "why": "the direct-fix digest is retired; a direct fix leaves its commit",
      "caseSensitive": true,
      "pattern": "\\buno-tier1-digest\\b"
    },
    {
      "not": "weekly-tier1-digest",
      "use": [
        "a direct fix leaves its commit"
      ],
      "why": "the direct-fix digest is retired; a direct fix leaves its commit",
      "caseSensitive": true,
      "pattern": "\\bweekly-tier1-digest\\b"
    },
    {
      "not": "NO_TIER1_THIS_WEEK",
      "use": [
        "a direct fix leaves its commit"
      ],
      "why": "the direct-fix digest is retired; a direct fix leaves its commit",
      "caseSensitive": true,
      "pattern": "\\bNO_TIER1_THIS_WEEK\\b"
    },
    {
      "not": "lane honors",
      "use": [
        "provider",
        "adapter"
      ],
      "why": "an adapter honors, reports or runs; \"lane\" in the provider sense is retired",
      "pattern": "\\blanes?[- ](?:honors?|report|reports|run|runs|log|logs)\\b"
    },
    {
      "not": "foundations-basics-*",
      "use": [
        "the Foundations groups"
      ],
      "why": "a retired Storybook id: Foundations is Brand, Visual, Layout, Expression, Accessibility and Tokens (motion and sound ids start foundations-expression-)",
      "caseSensitive": true,
      "pattern": "\\bfoundations-(?:basics|motion|sound)-[a-z-]+"
    },
    {
      "not": "Foundations \u203a Basics",
      "use": [
        "the Foundations groups"
      ],
      "why": "Motion and Sound sit under Foundations \u203a Expression; Basics is gone",
      "caseSensitive": true,
      "pattern": "\\bFoundations(?: \u00b7 |\\/)(?:Basics|Motion|Sound)\\b"
    },
    {
      "not": "Get started \u203a Content design",
      "use": [
        "Foundations \u203a Brand \u203a Content"
      ],
      "why": "Content design became Foundations \u203a Brand \u203a Content (Voice and tone, Language, Messages)",
      "caseSensitive": true,
      "pattern": "\\bGet started(?: \u203a |\\/)Content design\\b"
    },
    {
      "not": "@/patterns",
      "use": [
        "@/templates"
      ],
      "why": "the patterns barrel is gone; templates import from the templates barrel",
      "caseSensitive": true,
      "pattern": "['\"`]@/patterns(?:/[^'\"`]*)?['\"`]"
    },
    {
      "not": "--color-*",
      "use": [
        "a --ds-* color token"
      ],
      "why": "the Material --color-* roles are old; use the --ds-* color token for the role (fill, edge, text, icon)",
      "rule": "color",
      "caseSensitive": true,
      "pattern": "(?<![\\w-])--color-[a-z0-9*]"
    },
    {
      "not": "--elevation-light-*",
      "use": [
        "a --ds-* shadow or surface token"
      ],
      "why": "the --elevation-light-* shadows and --surface-* roles are old; use --ds-shadow-raised / --ds-shadow-overlay and the --ds-surface-* fill they pair with",
      "rule": "elevation",
      "caseSensitive": true,
      "pattern": "(?<![\\w-])--(?:elevation-light|surface)-[a-z0-9*]"
    },
    {
      "not": "--size-spacing-*",
      "use": [
        "a space, size, radius or template token"
      ],
      "why": "the old size names are gone; use the current token for the role: --space-* / --size-* / --radius-* / --stroke-* primitives, the --pad-* / --stack-* / --inline-* semantics, or the template tokens (--card-*, --section-*, --modal-*, --page-*, --table-*, --icon-*, --image-*, --row-height-*)",
      "rule": "size",
      "caseSensitive": true,
      "pattern": "(?<![\\w-])--size-(?:spacing|border|column|card|section|modal|surface|table|media|row|icon|indicator)-[a-z0-9*]"
    },
    {
      "not": "--font-size-h1",
      "use": [
        "a text style"
      ],
      "why": "the old type tokens and classes are gone; use a text style (font: var(--heading-*), var(--body-*), var(--metric-*), var(--code-default)), the --type-size-NNNN / --type-line-height-NNNN steps, --type-family-* and --type-weight-*, or --icon-* for a glyph",
      "rule": "type",
      "caseSensitive": true,
      "pattern": "(?<![\\w-])--(?:font-size-(?:(?:h[1-6]|body[1-3]|lead|blockquote|code|display[1-4])(?![\\w])|fa-[a-z0-9*])|font-(?:family|weight|line-height|letter-spacing)-[a-z0-9*])|(?<![\\w-])(?:body[1-3]|display[1-4]|body-lead|body-blockquote)-txt(?![\\w-])|class(?:Name)?=[\"'{`][^\"'}`>]*(?<![\\w-])h[1-6](?![\\w-])|(?<!-)\\.h[1-6](?![\\w-])"
    },
    {
      "not": "both lanes",
      "use": [
        "provider",
        "adapter"
      ],
      "why": "there is one agent loop and two adapters behind the ModelProvider seam; count adapters or providers, not lanes",
      "pattern": "\\b(?:both|two)[- ]lanes\\b"
    },
    {
      "not": "style=\"primary\"",
      "use": [
        "Button.appearance"
      ],
      "why": "a bare-identifier `style` prop is the old language; `appearance` names the look (inline CSS style is never a bare identifier)",
      "rule": "prop:style",
      "caseSensitive": true,
      "pattern": "\\bstyle=\"[a-z][a-z-]*\""
    },
    {
      "not": "fill=\"filled\"",
      "use": [
        "Button.appearance"
      ],
      "why": "the `fill` prop is gone; `appearance` names the look",
      "rule": "prop:fill",
      "caseSensitive": true,
      "pattern": "\\bfill=\"(?:filled|tonal|outline|ghost|text)\""
    },
    {
      "not": "size=\"small\"",
      "use": [
        "Button.spacing"
      ],
      "why": "the small / medium / large control sizes are gone; `spacing` is default, compact or spacious (a type-scale tag such as Heading takes xxl to xxs, read by tag in the check)",
      "rule": "prop:size",
      "caseSensitive": true,
      "pattern": "\\bsize=\"(small|medium|large|sm|md|lg)\""
    },
    {
      "not": "size=\"xxlarge\"",
      "use": [
        "Heading.size=sm",
        "Heading.size=lg"
      ],
      "why": "the type scale is token-named (xxl to xxs); its old words are gone",
      "rule": "prop:size",
      "typeScale": true,
      "caseSensitive": true,
      "pattern": "\\bsize=\"(?:xxlarge|xlarge|large|medium|small|xsmall|xxsmall)\""
    },
    {
      "not": "size: oneOf(['small', ...])",
      "use": [
        "Button.spacing"
      ],
      "why": "a prop type that declares the old control sizes never writes them as JSX, so only the declaration shows it",
      "rule": "proptype:size",
      "caseSensitive": true,
      "pattern": "\\bsize:\\s*(?:PropTypes\\.)?oneOf\\(\\s*\\[\\s*['\"](?:small|medium|large|sm|md|lg)['\"]"
    },
    {
      "not": "plus-btn--filled",
      "use": [
        "Button.appearance"
      ],
      "why": "the old button class modifiers are gone",
      "rule": "class:plus-btn",
      "caseSensitive": true,
      "pattern": "plus-btn--(?:filled|tonal|outline|ghost|text|small|medium|large)"
    },
