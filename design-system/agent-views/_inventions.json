      ],
      "why": "another design system's word"
    }
  ],
  "concepts": [
    "Blanket",
    "AI",
    "the PLUS rule",
    "direct fix",
    "gated change",
    "provider",
    "adapter",
    "Cut the noise"
  ],
  "allowed": [
    {
      "path": "docs/adr/",
      "why": "a decision record keeps the words it decided in"
    },
    {
      "path": "docs/knowledge/archive/",
      "why": "the graveyard records old words as history"
    },
    {
      "path": "docs/knowledge/changelog.md",
      "why": "a changelog names what was renamed"
    },
    {
      "path": "docs/plans/",
      "why": "a plan keeps the words it was written in"
    },
    {
      "path": "docs/evals/",
      "why": "eval history and scenarios are written in the old names on purpose"
    },
    {
      "path": "design-system/figma/",
      "why": "Figma-side names stay until Figma is renamed",
      "kinds": [
        "component",
        "prop",
        "token"
      ]
    }
  ]
