{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/uno-prototype/claude-code-run.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node .cursor/hooks/uno-prototype/claude-code-answer.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
