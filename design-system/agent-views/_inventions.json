    },
    {
      "path": "design-system/figma/",
      "why": "Figma-side names stay until Figma is renamed",
      "kinds": [
        "component",
        "prop",
        "token"
      ]
    },
    {
      "path": "todos/",
      "why": "working notes keep the words they were written in",
      "kinds": [
        "spelling"
      ]
    },
    {
      "path": "agents/uno-bot/harness-bundle.md",
      "why": "generated from the swept sources",
      "kinds": [
        "spelling"
      ]
    },
    {
      "path": "agents/uno-bot/src/",
      "why": "the Worker's source quotes the retired spellings it routes away from",
      "kinds": [
        "spelling"
      ]
    },
    {
      "path": "docs/evals/scenarios/",
      "why": "scenarios are fixtures an eval hands the agent under test, written in the old names on purpose"
    },
    {
      "path": "docs/evals/fixtures/",
      "why": "eval fixtures are written in the old names on purpose"
    },
    {
      "path": "docs/evals/ds-usage-ledger.jsonl",
      "why": "the eval ledger records what the agents wrote at the time"
    }
  ]
