{
  "schema_version": "1.0",
  "updated_for_branch": "main",
  "runtime_and_tooling": {
    "framework": "React",
    "ui_library": "React-Bootstrap",
    "bundler": "Vite",
    "storybook": "Storybook"
  },
  "canonical_commands": [
    "npm run dev",
    "npm run storybook",
    "npm run build",
    "npm run build-storybook",
    "npm run sync:tokens",
    "npm run generate:tokens"
  ],
  "key_paths": {
    "agent_system": "AGENTS.md + skills/ + agents/",
    "design_system_source": "design-system/src/",
    "design_system_docs": "design-system/guidelines/",
    "storybook_config": ".storybook/",
    "token_scripts": "scripts/",
    "prototyping": "prototypes/"
  },
  "context_levels": [
    {
      "name": "element",
      "token_scope": "--size-element-*",
      "typical_locations": [
        "design-system/src/components/",
        "design-system/src/components/forms-and-inputs/"
      ]
    },
    {
      "name": "card",
      "token_scope": "--card-*",
      "typical_locations": [
        "design-system/src/patterns/PatternCard/"
      ]
    },
    {
      "name": "section",
      "token_scope": "--section-*",
      "typical_locations": [
        "design-system/src/patterns/PatternSection/"
      ]
    },
    {
      "name": "table",
      "token_scope": "--table-*",
      "typical_locations": [
        "design-system/src/patterns/PatternTable/"
      ]
    },
    {
      "name": "modal",
      "token_scope": "--modal-*",
      "typical_locations": [
        "design-system/src/components/",
        "design-system/src/patterns/PatternModal/"
      ]
    },
    {
      "name": "page",
      "typical_locations": [
        "design-system/src/patterns/PageLayout/"
      ]
    }
  ],
  "terminology": {
    "element": "Small reusable unit (button, input, badge).",
    "card": "Grouped content container.",
    "section": "Major page region.",
    "table": "Structured tabular layout.",
    "modal": "Overlay dialog surface.",
    "pattern": "Higher-level composition (Frame, Page, Section, Card, Table, overlays, templates) in design-system/src/patterns."
  },
  "token_prefixes": [
    "--ds-*",
    "--space-*",
    "--size-*",
    "--pad-*",
    "--stack-*",
    "--inline-*",
    "--heading-*",
    "--body-*"
  ]
}
