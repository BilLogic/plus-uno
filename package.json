{
  "name": "plus-vibe-coding-starting-kit",
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Starter kit for PLUS design prototyping with Cursor agent",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently --names app,storybook --prefix-colors blue,magenta \"vite --port 4100\" \"npm run storybook\"",
    "dev:vite": "vite --port 4100",
    "dev:app": "vite --config prototypes/live-app/vite.config.js",
    "dev:live-app": "vite --config prototypes/live-app/vite.config.js",
    "test": "npm --prefix design-system test",
    "storybook": "NODE_OPTIONS=\"--require ./scripts/storybook-networkinterfaces-fix.cjs\" WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true storybook dev -p 4200 --host 0.0.0.0 --config-dir .storybook",
    "storybook:preview": "NODE_OPTIONS=\"--require ./scripts/storybook-networkinterfaces-fix.cjs\" WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true storybook dev -p ${PORT:-4200} --host 0.0.0.0 --config-dir .storybook",
    "build-storybook": "npm run generate:brand-image && storybook build --config-dir .storybook -o storybook-static && mkdir -p dist && rm -rf dist/storybook && mv storybook-static dist/storybook",
    "sync:tokens": "node scripts/sync-figma-tokens.js",
    "generate:tokens": "node scripts/generate-all-tokens.js",
    "generate:brand-image": "node scripts/generate-brand-image.js",
    "generate:agent": "node scripts/generate-agent.js",
    "generate:agent-views": "node scripts/generate-cheat-sheet.js && node scripts/generate-knowledge-components.js",
    "generate:component-registry": "node scripts/generate-component-registry-from-storybook.js",
    "generate:figma-links": "node scripts/generate-figma-links-spreadsheet.js",
    "snapshot:figma-variables": "node scripts/snapshot-figma-variables.mjs",
    "snapshot:figma-components": "node scripts/snapshot-figma-components.mjs",
    "generate:token-registry": "node scripts/generate-token-registry.mjs",
    "generate:knowledge-components": "node scripts/generate-knowledge-components.js",
    "generate:component-docs": "node scripts/generate-component-docs.mjs",
    "generate:index": "node scripts/generate-index.mjs",
    "report:doc-identifiers": "node scripts/check-doc-identifiers.mjs --report --stats",
    "audit:figma-registry": "node scripts/figma-registry-audit.mjs",
    "benchmark:atlassian": "node scripts/check-atlassian-benchmark.mjs --table",
    "generate:knowledge-audit": "node scripts/generate-knowledge-audit.js",
    "generate:check-registry": "node scripts/generate-check-scripts.mjs",
    "generate:skill-surfaces": "node scripts/generate-uno-skill-surfaces.mjs",
    "test:scripts": "node --test scripts/*.test.mjs scripts/lib/*.test.mjs",
    "start": "vite",
    "dev:react": "vite",
    "build:react": "vite build",
    "build": "npm run build:react",
    "build:netlify": "npm run build:all",
    "build:all": "npm run build && npm run build:demo && npm run build:post-session-reflection && npm run build-storybook",
    "build:demo": "vite build --config prototypes/home-redesign/vite.demo.config.js",
    "preview:react": "vite preview",
    "dev:home-redesign": "vite --config prototypes/home-redesign/vite.config.js",
    "dev:demo": "vite --config prototypes/home-redesign/vite.demo.config.js --open /demo.html",
    "dev:monthly-report": "vite --config prototypes/monthly-report/vite.config.js",
    "dev:post-session-reflection": "vite --config prototypes/post-session-reflection/vite.config.js",
    "build:post-session-reflection": "vite build --config prototypes/post-session-reflection/vite.config.js",
    "validate:figma-writeback": "node scripts/validate-figma-writeback-manifest.mjs",
    "audit:figma-writeback": "node scripts/audit-figma-writeback.mjs",
    "figma:poll": "node scripts/poll-figma-library.js",
    "figma:poll:init": "node scripts/poll-figma-library.js --init",
    "notify:slack": "node scripts/notify-slack.js",
    "//check-registry:begin": "GENERATED by scripts/generate-check-scripts.mjs from scripts/checks.registry.mjs — every check:* name below is a registry row. Add a check by adding a row, then run `npm run generate:check-registry`. `npm run check:check-registry` fails on drift.",
    "check:agent": "node scripts/generate-agent.js --check",
    "check:deps": "node scripts/check-deps.mjs",
    "check:deprecated-apis": "node scripts/check-deprecated-apis.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:doc-identifiers": "node scripts/check-doc-identifiers.mjs",
    "check:figma-links": "node scripts/generate-figma-links-spreadsheet.js --check",
    "check:figma-node-types": "node scripts/check-figma-node-types.mjs",
    "check:figma-snapshots": "node scripts/check-figma-snapshots.mjs",
    "check:skill-surfaces": "node scripts/generate-uno-skill-surfaces.mjs --check",
    "check:check-registry": "node scripts/generate-check-scripts.mjs --check",
    "check:skill-overlap": "node scripts/check-skill-overlap.mjs",
    "check:knowledge-disposition": "node scripts/check-knowledge-disposition.mjs",
    "check:negation": "node scripts/check-negation-ratchet.mjs",
    "check:pointers": "node scripts/check-pointers.mjs",
    "check:glossary": "node scripts/check-glossary.mjs",
    "check:retired-spelling": "node scripts/check-retired-spelling.mjs",
    "check:cross-repo": "node scripts/check-cross-repo-duplication.mjs",
    "check:button-contrast": "node scripts/check-button-contrast.mjs",
    "check:token-collision": "node scripts/check-token-collision.mjs",
    "check:colour-fallbacks": "node scripts/check-colour-fallbacks.mjs",
    "check:size-fallbacks": "node scripts/check-size-fallbacks.mjs",
    "check:undefined-tokens": "node scripts/check-undefined-tokens.mjs",
    "check:font-families": "node scripts/check-font-families.mjs",
    "check:figma-scopes": "node scripts/check-figma-scopes.mjs",
    "check:intent-roles": "node scripts/check-intent-roles.mjs",
    "check:focus-ring": "node scripts/check-focus-ring.mjs",
    "check:icon-button-name": "node scripts/check-icon-button-name.mjs",
    "check:node-floor": "node scripts/check-node-floor.mjs",
    "check:harness-budgets": "node scripts/check-harness-budgets.mjs",
    "check:figma-colour-drift": "node scripts/check-figma-colour-drift.mjs",
    "check:token-generation": "node scripts/check-token-generation.mjs",
    "check:atlassian-benchmark": "node scripts/check-atlassian-benchmark.mjs",
    "check:unspread-rest": "node scripts/check-unspread-rest.mjs",
    "check:docs-tabs": "node scripts/check-docs-tabs.mjs",
    "check:docs-token-literals": "node scripts/check-docs-token-literals.mjs",
    "check:docs-dead-selectors": "node scripts/check-docs-dead-selectors.mjs",
    "check:page-outline": "node scripts/check-page-outline.mjs",
    "check:intake-fsm": "node .cursor/hooks/uno-prototype/test-fsm.mjs",
    "check:typography-classes": "node scripts/check-typography-classes.mjs",
    "check:text-contrast": "node scripts/check-text-contrast.mjs",
    "check:harness": "node scripts/check-harness.mjs",
    "check:component-docs": "node scripts/generate-component-docs.mjs --check",
    "check:index": "node scripts/generate-index.mjs --check",
    "check:component-registry": "node scripts/generate-component-registry-from-storybook.js --check",
    "check:token-registry": "node scripts/generate-token-registry.mjs --check",
    "check:knowledge-audit": "node scripts/generate-knowledge-audit.js --check",
    "check:storybook": "node scripts/check-storybook.mjs",
    "check:docs-chrome": "node scripts/check-docs-chrome.mjs",
    "//check-registry:end": "END of the generated check:* block."
  },
  "keywords": [
    "plus",
    "design-system",
    "prototyping",
    "cursor"
  ],
  "author": "PLUS Design Team",
  "license": "ISC",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/html-vite": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.0",
    "agentic-service-blueprinting": "github:BilLogic/agentic-service-blueprinting#v1.6.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "playwright": "^1.63.0",
    "sass": "^1.104.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.2.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.19",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-react": "^6.1.1",
    "bootstrap": "^5.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "highcharts": "^13.0.2",
    "highcharts-react-official": "^3.2.3",
    "radix-ui": "^1.4.3",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "typescript": "^7.0.2"
  }
}
