  "spellings": [
    {
      "not": "Tier 1 fix",
      "use": [
        "direct fix",
        "gated change"
      ],
      "why": "Tier names the loading tiers and nothing else",
      "pattern": "\\bTier[- ]?1/2\\b|\\bTier[- ]?[12] (?:fix|fixes|change|changes|digest|whitelist|pipeline|scope|apply)\\b|\\bTier[- ]?1 (?:only|auto-apply)\\b",
      "caseSensitive": true
    },
    {
      "not": "Gemini lane",
      "use": [
        "provider",
        "adapter"
      ],
      "why": "the model-provider sense of lane is retired; lane keeps the blueprint's actor-row meaning, so only a provider word beside it is flagged",
      "pattern": "\\b(?:Gemini|Claude|Vertex-Claude|Anthropic|model|models|provider|providers|production|active|fallback|backup)[- ]lanes?\\b|\\b(?:both|two|either|each|per)[- ](?:provider|model|agent) lanes?\\b|\\beither[- ]lanes?\\b"
    },
    {
      "not": "Quiet by default",
      "use": [
        "Cut the noise"
      ],
