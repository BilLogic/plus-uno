{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/require-prd-for-prototype.sh",
        "matcher": "UserPromptSubmit",
        "failClosed": false,
        "timeout": 10
      },
      {
        "command": ".cursor/hooks/require-ds-writeback.sh",
        "matcher": "UserPromptSubmit",
        "failClosed": false,
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/uno-prototype/run.mjs --session-end",
        "timeout": 5
      },
      {
        "command": "node .cursor/hooks/uno-writeback/run.mjs --session-end",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/ds-usage/post-edit.mjs",
        "timeout": 15
      }
    ]
  }
}
