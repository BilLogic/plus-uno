  "tokens": [
    {
      "not": "--space-025 (4px)",
      "use": [
        "--stack-sm",
        "--inline-sm",
        "--pad-x-xs"
      ],
      "why": "a primitive; read the step for the role"
    },
    {
      "not": "--space-050 (8px)",
      "use": [
        "--stack-md",
        "--inline-md",
        "--pad-x-sm"
      ]
    },
    {
      "not": "--space-075 (12px)",
      "use": [
        "--stack-lg",
        "--inline-lg",
        "--pad-x-md"
      ]
    },
    {
      "not": "--space-100 (16px)",
      "use": [
        "--stack-xl",
        "--inline-xl",
        "--pad-x-lg"
      ]
    },
    {
      "not": "--space-150 (24px)",
      "use": [
        "--stack-2xl",
        "--inline-2xl",
        "--page-pad"
      ]
    },
    {
      "not": "--space-200 (32px) and up",
      "use": [
        "--stack-3xl",
        "--inline-3xl"
      ],
      "why": "general gaps; --page-stack-lg is only for Page"
    },
    {
      "not": "--radius-<n>",
      "use": [
        "--radius-md",
        "--radius-xl"
      ],
      "why": "read the semantic step for the role: --radius-sm to --radius-xxl, or --radius-control-sm, -md, -lg for a control by height"
    },
    {
      "not": "--ds-on-surface",
      "use": [
        "--ds-text",
        "--ds-text-subtle"
      ]
    },
    {
      "not": "--size-element-*, --element-*",
      "use": [
        "--pad-x-md",
        "--stack-md",
        "--radius-md"
      ],
      "why": "retired; these are the commonest replacements, and check:ds-usage names the exact one for each old name"
    }
  ],
  "words": [
    {
      "not": "surface container",
      "use": [
